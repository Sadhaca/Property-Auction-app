# =============================================================================
# AuctionProp - India Property Auction Discovery Platform
# Environment Configuration
# =============================================================================

# App
APP_NAME=AuctionProp
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://auctionprop:auctionprop@localhost:5432/auctionprop
DATABASE_URL_SYNC=postgresql://auctionprop:auctionprop@localhost:5432/auctionprop

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin
ADMIN_EMAIL=admin@auctionplatform.in
ADMIN_PASSWORD=Admin@123456

# AWS S3 Compatible Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=auctionprop-documents
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=

# OpenAI (for AI extraction and summaries)
OPENAI_API_KEY=sk-your-openai-key

# Sentry (error monitoring)
SENTRY_DSN=

# Admin Panel
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mobile App
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
